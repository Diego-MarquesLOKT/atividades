//Q1


void merge(int vet[], int esq, int meio, int dir) {
   int i = esq, j = meio+1, k = 0;
   int aux[dir - esq + 1];

   while (i<= meio && j<=dir){
        aux[k++] = (vet[i] <= vet[j]) ? vet[i++] : vet[j++];
   }
   while(i <=meio){
    aux[k++]=vet[i++];
   }
   while(j<=dir)
   {
       aux[k++]=vet[j++];
   }
   for(i = esq,k=0;i<=dir;i++,k++)
   {
       vet[i]=aux[k];
   }

}
void mergeSort(int v[],int e, int d)
{
    if(e < d)
    {
        int m = (e+d)/2;
        mergeSort(v,e,m);
        mergeSort(v,m+1,d);
        merge(v,e,m,d);
    }
}
