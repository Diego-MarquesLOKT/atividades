bool auxPalindromo(char v1[],int n, int d)
{
    if(n == 0)
    {
        return true;
    }
    if(d == n)
    {
        return true;
    }else
    if(v1[d] == v1[n-1])
    {
    return  auxPalindromo(v1,n-1,d+1);
    }else{
        return false;
    }
}


bool palindromo(char v1[], int n)
{
    return auxPalindromo(v1,n,0);
}

bool palindromo(char v1[].int n)
{
    if(n == 0)
    {
        return true;
    }
    int alg = palindromo(v1,n-1);
    if(alg == v1[n-1])
    {
        return true
    }
}
