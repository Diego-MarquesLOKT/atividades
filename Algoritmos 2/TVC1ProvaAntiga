int fatorial(int n)
{
    if(n == 0)
    {
        return 1;
    }
    return n*fatorial(n-1);
}

int potencia(int x, int n)
{
    if(n == 0)
    {
            return 1;
    }
    else
        return  x*potencia(x,n-1);
}



float expo(float x, int n)
{
  if(n == 0)
    return 1.0;
  else
    return (float)potencia(x,n)/fatorial(n) + expo(x,n-1);
}

