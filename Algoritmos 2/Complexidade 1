#include <iostream>

using namespace std;

int fibonnacci(int n)
{
    if(n == 1)
    {
        return 1;
    }else if(n==0)
    {
        return 0;
    } //complexidade O = 1
    else
    {
        int pen = 0;
        int ult = 1;
        int atual = 1;
        for (int i =2; i <= n;i++)
        {
            atual = ult + pen;
            pen = ult;
            ult = atual;
        } // complexidade O = n - 1;
        return atual; // complexidade O = 1;
    }

}
//ORDEM DE GRANDEZA TOTAL -> On-1;

int main()
{
    int n = 0;  // complexidade O = 1 
    cin >> n; // complexidade O = 1;
    cout << fibonnacci(n);// complexidade O = 1;
    return 0;
 }
