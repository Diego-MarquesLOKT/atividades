// A funcao recursiva ja esta pronta para testar o seu merge!
void mergeSort(int vet[], int esq, int dir) {
    if(esq < dir) {
        int meio = (esq + dir) / 2;
        mergeSort(vet, esq, meio);
        mergeSort(vet, meio + 1, dir);
        merge(vet, esq, meio, dir);
    }
}
