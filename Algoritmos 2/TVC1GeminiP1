//Q2
int* filtraMaiores(int vet[], int n, int x, int *novoTamanho) {
    for(int i = 0; i < n;i++)
    {
        if(vet[i] > x)
        {
            (*novoTamanho)++;
        }
    }
        if(*novoTamanho <= 0)
        {
            *novoTamanho = 0;
        return NULL;
        }
        int *vetm = new int[*novoTamanho];
        int j = 0;
        for(int i = 0; i < n;i++)
    {
        if(vet[i] > x)
        {
            *(vetm + j) = vet[i];
            j++;
        }
    }
    return vetm;
}
//-Q2


//Q3
int somaDigitosPares(int n) {
    if(n == 0) {
        return 0; // Caso base
    }

    int digito = n % 10;

    if(digito % 2 == 0) {
        return digito + somaDigitosPares(n / 10); // É par, soma o dígito
    } else {
        return somaDigitosPares(n / 10); // É ímpar, ignora o dígito
    }
}
//-Q3


//Q4
int contaOcorrencias(int vet[], int n, int x) {
    // Caso base: vetor vazio
    if(n == 0) {
        return 0;
    }
    
    // Verifica o ÚLTIMO elemento atual (índice n-1)
    if(vet[n - 1] == x) {
        return 1 + contaOcorrencias(vet, n - 1, x);
    } else {
        return contaOcorrencias(vet, n - 1, x);
    }
}
