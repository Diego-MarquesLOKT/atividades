//Q1
void calculaEstatisticas(int *vet, int n, int *soma, int *maior) {
   *soma = 0;
   *maior = *(vet);
    for(int i = 0; i < n;i++)
    {
        if(*(vet + i) > *maior)
        {
            *maior = *(vet + i);
        }
        *soma += *(vet+i);
    }

}
//-Q1


//Q2
int* intercalaVetor(int v1[], int v2[], int n) {
    int *vet= new int[2*n];
    int contador1 = 0;
    int contador2 = 0;
    for(int i = 0; i < 2*n;i++)
    {
        if(i%2 == 0)
        {
            vet[i] = v1[contador1];
            contador1++;
        }
        else{
            vet[i] = v2[contador2];
            contador2++;
        }
    }

    return vet;
}

//-Q2


//Q3
int somaIntervalo(int a, int b) {
    if(a == b)
    {
        return a;
    }
    if(a < b)
    {
    if(a != b)
        return a + somaIntervalo(a+1,b);
        else
            return 0;
    }else{
        if(a != b)
        return b + somaIntervalo(a,b+1);
        else
            return 0;
    }
}
//-Q3


//Q4
bool verificaNegativo(int vet[], int n) {
    if(n == 0)
    {
        return false;
    }
    if(vet[n-1] < 0)
    {
        return true;
    }
     return verificaNegativo(vet,n-1);

}
