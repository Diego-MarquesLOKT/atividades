void inverte(int vet[],int n)
{
    int aux;//1

    for(int i = 0; i < n/2 ;i++)//
    {
        aux = vet[i];
        vet[i] = vet[n-i-1];
        vet[n-i-1] = aux; 
    }
    for(int i = 0; i < n;i++)//n-1
    {
        cout << vet[i] << " ";
    }
}

int main()
{
    int vet[5] = {1,2,3,4,5};

    inverte(vet,5);
    return 0;
 }
