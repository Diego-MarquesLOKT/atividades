#include <iostream>

using namespace std;

bool func(int tam, int vet[], int *par, int *impar, int *negativos)
{
    *negativos = 0;
    for(int i = 0; i < tam;i++)
    {
        if(vet[i] < 0)
        {
            (*negativos)++;
        }
        if(vet[i]%2 == 0){
            (*par)++;
        }else{
            (*impar)++;
        }

    }
    if(*negativos == 0)
    {
        return false;
    }else{
    return true;
    }

}


int main()
{
    int tam;
    cout << "Digite o tamanho do vetor : ";
    cin >> tam;
    cout << "Digite o vetor: " << endl;
    int vet[tam];
    for ( int i = 0; i < tam;i++)
    {
        cin >> vet[i];
    }
    int par = 0;
    int impar = 0;
    int negativos = 0;

    cout << "O valor retornado e " << func(tam,vet,&par,&impar,&negativos) << endl;
    cout << "A quantidade de numeros pares sao: " << par << endl;
    cout << "A quantidade de numeros impares sao: " << impar <<endl;
    return 0;
}
