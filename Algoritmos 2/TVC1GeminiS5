void indicePares(int* vet, int n) {
    if (n == 0) {
        return; // Caso base: vetor acabou
    }

    // 1º Passo: Chama a recursão ANTES de imprimir.
    // Isso faz a função ir até o início do vetor primeiro.
    indicePares(vet, n - 1);

    // 2º Passo: Na "volta" da recursão, ele verifica e imprime.
    // Como estamos na volta, ele imprimirá do menor (0) para o maior (n-1).
    if (vet[n - 1] % 2 == 0) {
        cout << (n - 1) << " ";
    }
}

