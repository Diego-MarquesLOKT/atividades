//Q1
bool analisaVetor(int tam, int *vet, int *par, int *impar, int *negativos) {
    *par = 0;
    *impar = 0;
    *negativos = 0;

    for(int i = 0;i < tam;i++)
    {
        if(vet[i]%2 == 0)
        {
            (*par)++;
        }else{
            (*impar)++;
        }
        if(vet[i] < 0)
        {
            (*negativos)++;
        }
    }
    if(*negativos > 0)
    {
        return true;
    }else{
    return false;
    }


}
