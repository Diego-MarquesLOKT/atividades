//Q2
int* subvetor(int n, int *vet, int inicio, int fim, int *tamSub) {
    *tamSub = 0;
    if(inicio > fim)
    {
        return NULL;
    }
    *tamSub = 1+fim - inicio;
    int *nvet = new int[*tamSub];
    int contador = 0;
    for(int i = inicio; i < fim+1;i++)
    {
        *(nvet + contador) = vet[i];
            contador++;
        }
    return nvet;
}
