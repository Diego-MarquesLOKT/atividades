//Q1
void copiaPositivos(int *origem, int *destino, int n, int *qtd) {
   *qtd = 0;
   int c = 0;
   for(int i = 0; i < n;i++)
   {
       if(*(origem + i)> 0)
       {
           *(destino + c) = *(origem + i);
           c++;
           (*qtd)++;
       }
   }

}
