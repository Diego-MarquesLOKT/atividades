int menorElemento(int vet[], int n) {
    // Caso base: Se só tem 1 elemento, ele é o menor!
    if (n == 1) {
        return vet[0];
    }

    // Passo 1: Pega o menor elemento do resto do vetor (mágica da recursão)
    int menorDoResto = menorElemento(vet, n - 1);

    // Passo 2: O elemento que eu estou olhando agora (n-1) é menor que o do resto?
    if (vet[n - 1] < menorDoResto) {
        return vet[n - 1]; // Se for, o meu atual vence
    } else {
        return menorDoResto; // Se não, o do resto vence
    }
}
