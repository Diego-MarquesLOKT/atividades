bool auxehPrimo(int n, int dig)
{
    if(n == 1)
    {
        return false;
    }
    if(dig == n)
    {
        return true;
    }

        if(n%dig == 0)
    {
        return false;
    }
            return auxehPrimo(n,dig+1);

}

bool ehPrimo(int n) {

    return auxehPrimo(n,2);
}
