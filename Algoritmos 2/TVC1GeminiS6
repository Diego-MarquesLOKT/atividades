//Q2
int* extraiIndicesPares(int vet[], int n, int *novoTamanho) {
    *novoTamanho = 0;
    for(int i = 0; i < n;i++)
    {
        if(i%2 == 0)
        {
            (*novoTamanho)++;
        }
    }
    int *nvet = new int[*novoTamanho];
    int c = 0;
     for(int i = 0; i < n;i++)
    {
        if(i%2 == 0)
        {
            *(nvet + c) = vet[i];
            c++;
        }
    }
    return nvet;
}
