//Q1
void q1() {
  int v[6] = {10, 20, 30, 40, 50, 60};
  int *p1 = &v[0];
  int *p2= &v[5];
  while(p1 < p2)
  {
      int temp = *p1;
      *p1 = *p2;
      *p2 = temp;

      p1++;
      p2--;
  }

  for (int i = 0;i < 6;i++)
  {
      cout << v[i] << " ";
  }

}
//-Q1


//Q2
int* extrairImpares(int vet[], int n, int *tamImpares) {
    *tamImpares = 0;
    for(int i = 0; i < n; i++)
    {
        if(vet[i]%2 != 0)
        {
            (*tamImpares)++;
        }
    }
    if(*tamImpares <= 0)
    {
        return NULL;
    }
    int j = 0;
    int *vetImpar = new int [*tamImpares];
    for(int i = 0; i < n;i++)
    {
         if(vet[i]%2 != 0)
        {
            *(vetImpar + j) = vet[i];
            j++;
        }
    }

   return vetImpar;
}
//-Q2


//Q3
float harmonico(int n) {
    if(n==1)
    {
        return 1.0;
    }
    return 1.0/n + harmonico(n-1);
}
//-Q3


//Q4
int somaPositivos(int vet[], int n) {
    if(n == 0)
    {
        return 0;
    }
    if(vet[n-1]>0)
    {
        return vet[n - 1] + somaPositivos(vet,n-1);
    }else{
        return somaPositivos(vet,n-1);
    }

}
