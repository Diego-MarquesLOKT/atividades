//CORREÇÃO!
int iguais(int vet1[], int vet2[], int n) {
   if(n == 0) return -1;

   // Primeiro, procura nas posições anteriores (da esquerda)
   int pos = iguais(vet1, vet2, n-1);

   if(pos != -1) {
       return pos; // Se achou diferença lá atrás, retorna ela
   } else if (vet1[n-1] != vet2[n-1]) {
       return n-1; // Se lá atrás tava tudo igual, testa a posição atual
   } else {
       return -1; // Tudo igual
   }
}
