//Q1
void trocaVetores(int *vetA, int *vetB, int tam) {
    for(int i = 0; i < tam;i++)
    {
        int temp = *(vetA + i);
        *(vetA + i) = *(vetB + i);
        *(vetB + i) = temp;
    }
}
//-Q1


//Q2
int* removeVal(int vet[], int n, int val, int *novoTamanho) {
    *novoTamanho = 0;
    for(int i = 0;i < n;i++)
    {
            if(vet[i] != val)
            {
                (*novoTamanho)++;
            }
    }
    if(*novoTamanho <= 0)
    {
        return NULL;
    }
    int *vetnovo = new int [*novoTamanho];
    int j = 0;
    for(int i = 0; i < n;i++)
    {
            if(vet[i] != val)
            {
              *(vetnovo + j) = vet[i];
              j++;
            }
    }
    return vetnovo;
}
//-Q2


//Q3
float pot(float x, int n) {
    if(n == 0)
    {
        return 1.0;
    }
    else if(n < 0)
    {
        return pot(1.0/x,-n);// corrigido!
    }else
    {
        return x*pot(x,n-1);
    }

}
