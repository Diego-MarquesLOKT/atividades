#include <iostream>

using namespace std;

int pares(int vet[], int n)
{
    if(n == 1){
        if(vet[0] % 2 == 0){
            return 1;
        }else{
            return 0;
             }

    }
    if(vet[n-1] % 2 == 0)
    {
        return pares(vet,n-1) + 1;
    }else{
        return pares(vet,n-1);
    }
}


int main()
{
    int n;
    cout << "Digite o tamanho do vetor: ";
    cin >>n;
    int vet[n];
  cout <<" Digite o vetor: " << endl;
for(int i = 0; i < n;i++)
{
    cin >> vet[i];
}
    cout << "Numero de pares: " <<pares(vet,n);

  return 0;
}
