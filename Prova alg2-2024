void q1()
{
    int *vet = new int[3];
    *vet = 5;
    *(vet + 1) = 1;
    *(vet + 2) = 7;
    imprimeVetor(vet,3);
    int *p1;
    p1 = vet;
    int *p2;
    p2 = vet + 2;
    int aux = *p1;
    *p1 = *p2;
    *p2 = aux;
    imprimeVetor(vet,3);
    delete [] vet;

}
